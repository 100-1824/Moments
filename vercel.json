{
    "version": 2,
    "framework": "vite",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3",
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.php"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "env": {
        "APP_NAME": "Moments",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_KEY": "base64:QHyh7ZzK8QvgcQAWJyOvxR/heQnXgREFTxMZi8SX2qo=",
        "LOG_CHANNEL": "stderr",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "array",
        "QUEUE_CONNECTION": "sync",
        "FILESYSTEM_DISK": "local",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": "/tmp/moments.sqlite"
    }
}
