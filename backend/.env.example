APP_NAME=Moments
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://moments.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database (serverless Postgres or MySQL) -----------------------------
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=moments
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=5

# --- Stateless caches & queues -------------------------------------------
SESSION_DRIVER=array
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync
CACHE_STORE=array
CACHE_PREFIX=moments

# --- Storage: S3 ONLY ----------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- CORS ----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://moments.example.com
CORS_ALLOWED_ORIGIN_PATTERNS=

# --- Sanctum -------------------------------------------------------------
SANCTUM_TOKEN_PREFIX=mom_
